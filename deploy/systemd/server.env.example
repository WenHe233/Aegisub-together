# Argon2id hash generated by `aegisub-together-server hash-password`.
# Single quotes preserve the '$' characters; never put the plaintext password here.
AEGISUB_COLLAB_ACCESS_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$REPLACE_WITH_GENERATED_HASH'
AEGISUB_COLLAB_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ARCHIVE_DAYS=0
