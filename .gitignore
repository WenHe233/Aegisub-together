# Meson
build*/
/subprojects/*
!/subprojects/*.wrap
!/subprojects/packagefiles
!/subprojects/csri
!/subprojects/iconv
!/subprojects/luabins
AGENTS.md

# Release helper secrets: holds the OpenAI key, must never be committed
/tools/release/release.config.apikey.json

# Rewritten every time a release script runs, so it shows up as a change
/tools/release/__pycache__/

# Where release.cmd builds the zips. The changelogs beside them under /changelog
# are tracked on purpose: the program reads those from this repository.
/_release/
